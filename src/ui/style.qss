/* Modern Dark Theme for YouTube Music Desktop App */

QMainWindow {
    background-color: #121212;
}

QLabel {
    color: #e0e0e0;
    font-size: 14px;
}

QPushButton {
    background-color: #1ed760;
    color: #121212;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: bold;
    border: none;
}

QPushButton:hover {
    background-color: #1fdf64;
}

QPushButton:pressed {
    background-color: #169c46;
}

QLineEdit {
    background-color: #2a2a2a;
    color: #ffffff;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    padding: 6px;
}

QLineEdit:focus {
    border: 1px solid #1ed760;
}

/* Toggle specific styles */
QPushButton#toggleModeBtn {
    background-color: #333333;
    color: #ffffff;
    font-weight: bold;
    border-radius: 15px;
    padding: 5px 15px;
}

QPushButton#toggleModeBtn:checked {
    background-color: #1ed760;
    color: #000000;
}
