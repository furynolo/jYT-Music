/* Modern Dark Theme for YouTube Music Desktop App */

QMainWindow {
    background-color: #121212;
}

QLabel {
    color: #e0e0e0;
    font-size: 14px;
}

QPushButton {
    background-color: #1ed760;
    color: #121212;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: bold;
    border: none;
}

QPushButton:hover {
    background-color: #1fdf64;
}

QPushButton:pressed {
    background-color: #169c46;
}

QLineEdit {
    background-color: #2a2a2a;
    color: #ffffff;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    padding: 6px;
}

QLineEdit:focus {
    border: 1px solid #1ed760;
}

/* Toggle specific styles */
QPushButton#toggleModeBtn {
    background-color: #333333;
    color: #ffffff;
    font-weight: bold;
    border-radius: 15px;
    padding: 5px 15px;
}

QPushButton#toggleModeBtn:checked {
    background-color: #1ed760;
    color: #000000;
}

/* Custom Large Scrollbars */
QScrollBar:vertical {
    background-color: #1a1a1a;
    width: 18px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #333;
    min-height: 30px;
    border-radius: 9px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #444;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #1a1a1a;
    height: 18px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #333;
    min-width: 30px;
    border-radius: 9px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #444;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background: none;
    width: 0px;
}
